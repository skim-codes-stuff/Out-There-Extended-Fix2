{
  "manifest_version": 3,
  "name": "Out There",
  "version": "261015",
  "icons":{
    "16": "icon/icon_128.png",
    "48": "icon/icon_128.png",
    "128": "icon/icon_128.png"
  },
  "description": "My Chrome Extension",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icons":{
    "16": "icon/icon_128.png",
    "48": "icon/icon_128.png",
    "128": "icon/icon_128.png"
  }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}